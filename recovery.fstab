# mount point   fstype    device                                             flags
/system         ext4      /dev/block/platform/msm_sdcc.1/by-name/system      flags=display="System";backup=1
/system_image   emmc      /dev/block/platform/msm_sdcc.1/by-name/system      flags=display="System Image";backup=1;flashimg=1
# The kernel reports both p44 and p47 as userdata; p44 is the working Android data partition.
/data           ext4      /dev/block/mmcblk0p44                              flags=display="Data";backup=1
/cache          ext4      /dev/block/platform/msm_sdcc.1/by-name/cache       flags=display="Cache";backup=1;wipeingui
/persist        ext4      /dev/block/platform/msm_sdcc.1/by-name/persist     flags=display="Persist";backup=1
/firmware       vfat      /dev/block/platform/msm_sdcc.1/by-name/modem       flags=display="Firmware";mounttodecrypt
/boot           emmc      /dev/block/platform/msm_sdcc.1/by-name/boot        flags=display="Boot";backup=1;flashimg=1
/recovery       emmc      /dev/block/platform/msm_sdcc.1/by-name/recovery    flags=display="Recovery";backup=1;flashimg=1
/misc           emmc      /dev/block/platform/msm_sdcc.1/by-name/misc        flags=display="Misc"
/radio          emmc      /dev/block/platform/msm_sdcc.1/by-name/modem       flags=display="Modem";backup=1
/aboot          emmc      /dev/block/platform/msm_sdcc.1/by-name/aboot       flags=display="Bootloader (aboot)";backup=1
/usb-otg        auto      /devices/platform/xhci-hcd/usb*                    flags=display="USB-OTG";storage;wipeingui;removable
